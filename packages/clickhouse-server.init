#!/bin/sh
### BEGIN INIT INFO
# Provides:          vxdfs-server
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Should-Start:      $time $network
# Should-Stop:       $network
# Short-Description: vxdfs-server daemon
### END INIT INFO
#
# NOTES:
# - Should-* -- script can start if the listed facilities are missing, unlike Required-*
#
# For the documentation [1]:
#
#   [1]: https://wiki.debian.org/LSBInitScripts

VXDFS_USER=vxdfs
VXDFS_GROUP=${VXDFS_USER}
SHELL=/bin/bash
PROGRAM=vxdfs-server
VXDFS_GENERIC_PROGRAM=vxdfs
VXDFS_PROGRAM_ENV=""
EXTRACT_FROM_CONFIG=${VXDFS_GENERIC_PROGRAM}-extract-from-config
VXDFS_CONFDIR=/etc/$PROGRAM
VXDFS_LOGDIR=/var/log/vxdfs-server
VXDFS_LOGDIR_USER=root
VXDFS_DATADIR=/var/lib/vxdfs
if [ -d "/var/lock" ]; then
    LOCALSTATEDIR=/var/lock
else
    LOCALSTATEDIR=/run/lock
fi

if [ ! -d "$LOCALSTATEDIR" ]; then
    mkdir -p "$LOCALSTATEDIR"
fi

VXDFS_BINDIR=/usr/bin
VXDFS_CRONFILE=/etc/cron.d/vxdfs-server
VXDFS_CONFIG=$VXDFS_CONFDIR/config.xml
LOCKFILE=$LOCALSTATEDIR/$PROGRAM
VXDFS_PIDDIR=/var/run/$PROGRAM
VXDFS_PIDFILE="$VXDFS_PIDDIR/$PROGRAM.pid"
# VXDFS_STOP_TIMEOUT=60 # Disabled by default. Place to /etc/default/clickhouse if you need.

# Some systems lack "flock"
command -v flock >/dev/null && FLOCK=flock

# Override defaults from optional config file and export them automatically
set -a
test -f /etc/default/vxdfs  && . /etc/default/vxdfs
set +a

die()
{
    echo $1 >&2
    exit 1
}


# Check that configuration file is Ok.
check_config()
{
    if [ -x "$VXDFS_BINDIR/$EXTRACT_FROM_CONFIG" ]; then
        su -s $SHELL ${VXDFS_USER} -c "$VXDFS_BINDIR/$EXTRACT_FROM_CONFIG --config-file=\"$VXDFS_CONFIG\" --key=path" >/dev/null || die "Configuration file ${VXDFS_CONFIG} doesn't parse successfully. Won't restart server. You may use forcerestart if you are sure.";
    fi
}


initdb()
{
    ${VXDFS_GENERIC_PROGRAM} install --user "${VXDFS_USER}" --pid-path "${VXDFS_PIDDIR}" --config-path "${VXDFS_CONFDIR}" --binary-path "${VXDFS_BINDIR}"
}


start()
{
    ${VXDFS_GENERIC_PROGRAM} start --user "${VXDFS_USER}" --pid-path "${VXDFS_PIDDIR}" --config-path "${VXDFS_CONFDIR}" --binary-path "${VXDFS_BINDIR}"
}


stop()
{
    ${VXDFS_GENERIC_PROGRAM} stop --pid-path "${VXDFS_PIDDIR}"
}


restart()
{
    ${VXDFS_GENERIC_PROGRAM} restart --user "${VXDFS_USER}" --pid-path "${VXDFS_PIDDIR}" --config-path "${VXDFS_CONFDIR}" --binary-path "${VXDFS_BINDIR}"
}


forcestop()
{
    ${VXDFS_GENERIC_PROGRAM} stop --force --pid-path "${VXDFS_PIDDIR}"
}


service_or_func()
{
    if [ -x "/bin/systemctl" ] && [ -f /etc/systemd/system/vxdfs-server.service ] && [ -d /run/systemd/system ]; then
        systemctl $1 $PROGRAM
    else
        $1
    fi
}

forcerestart()
{
    forcestop
    # Should not use 'start' function if systemd active
    service_or_func start
}

use_cron()
{
    # 1. running systemd
    if [ -x "/bin/systemctl" ] && [ -f /etc/systemd/system/vxdfs-server.service ] && [ -d /run/systemd/system ]; then
        return 1
    fi
    # 2. checking whether the config is existed
    if [ ! -f "$VXDFS_CRONFILE" ]; then
        return 1
    fi
    # 3. disabled by config
    if [ -z "$VXDFS_CRONFILE" ]; then
        return 2
    fi
    return 0
}
# returns false if cron disabled (with systemd)
enable_cron()
{
    use_cron && sed -i 's/^#*//' "$VXDFS_CRONFILE"
}
# returns false if cron disabled (with systemd)
disable_cron()
{
    use_cron && sed -i 's/^#*/#/' "$VXDFS_CRONFILE"
}


is_cron_disabled()
{
    use_cron || return 0

    # Assumes that either no lines are commented or all lines are commented.
    # Also please note, that currently cron file for ClickHouse has only one line (but some time ago there was more).
    grep -q -E '^#' "$VXDFS_CRONFILE";
}


main()
{
    # See how we were called.
    EXIT_STATUS=0
    case "$1" in
    start)
        service_or_func start && enable_cron
        ;;
    stop)
        disable_cron
        service_or_func stop
        ;;
    restart)
        service_or_func restart && enable_cron
        ;;
    forcestop)
        disable_cron
        forcestop
        ;;
    forcerestart)
        forcerestart && enable_cron
        ;;
    reload)
        service_or_func restart
        ;;
    condstart)
        service_or_func start
        ;;
    condstop)
        service_or_func stop
        ;;
    condrestart)
        service_or_func restart
        ;;
    condreload)
        service_or_func restart
        ;;
    initdb)
        initdb
        ;;
    enable_cron)
        enable_cron
        ;;
    disable_cron)
        disable_cron
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart|forcestop|forcerestart|reload|condstart|condstop|condrestart|condreload|initdb}"
        exit 2
        ;;
    esac

    exit $EXIT_STATUS
}


status()
{
    ${VXDFS_GENERIC_PROGRAM} status --pid-path "${VXDFS_PIDDIR}"
}


# Running commands without need of locking
case "$1" in
status)
    status
    exit 0
    ;;
esac


(
    if $FLOCK -n 9; then
        main "$@"
    else
        echo "Init script is already running" && exit 1
    fi
) 9> $LOCKFILE
