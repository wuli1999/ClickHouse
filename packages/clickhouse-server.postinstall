#!/bin/sh
set -e
# set -x

PROGRAM=vxdfs-server
VXDFS_USER=${VXDFS_USER:-vxdfs}
VXDFS_GROUP=${VXDFS_GROUP:-${VXDFS_USER}}
# Please note that we don't support paths with whitespaces. This is rather ignorant.
VXDFS_CONFDIR=${VXDFS_CONFDIR:-/etc/vxdfs-server}
VXDFS_DATADIR=${VXDFS_DATADIR:-/var/lib/vxdfs}
VXDFS_LOGDIR=${VXDFS_LOGDIR:-/var/log/vxdfs-server}
VXDFS_BINDIR=${VXDFS_BINDIR:-/usr/bin}
VXDFS_GENERIC_PROGRAM=${VXDFS_GENERIC_PROGRAM:-vxdfs}
VXDFS_PIDDIR=/var/run/$PROGRAM

# Provide clickhouse-keeper
KEEPER_CONFDIR=${KEEPER_CONFDIR:-/etc/vxdfs-keeper}
KEEPER_DATADIR=${KEEPER_DATADIR:-/var/lib/vxdfs}
KEEPER_LOGDIR=${KEEPER_LOGDIR:-/var/log/vxdfs-keeper}

[ -f /usr/share/debconf/confmodule ] && . /usr/share/debconf/confmodule
[ -f /etc/default/vxdfs ] && . /etc/default/vxdfs

if [ ! -f "/etc/debian_version" ]; then
    not_deb_os=1
fi

if [ "$1" = configure ] || [ -n "$not_deb_os" ]; then

    ${VXDFS_GENERIC_PROGRAM} install --user "${VXDFS_USER}" --group "${VXDFS_GROUP}" --pid-path "${VXDFS_PIDDIR}" --config-path "${VXDFS_CONFDIR}" --binary-path "${VXDFS_BINDIR}" --log-path "${VXDFS_LOGDIR}" --data-path "${VXDFS_DATADIR}"

    if [ -x "/bin/systemctl" ] && [ -f /lib/systemd/system/vxdfs-server.service ] && [ -d /run/systemd/system ]; then
        # if old rc.d service present - remove it
        if [ -x "/etc/init.d/vxdfs-server" ] && [ -x "/usr/sbin/update-rc.d" ]; then
            /usr/sbin/update-rc.d vxdfs-server remove
        fi

        /bin/systemctl daemon-reload
        /bin/systemctl enable vxdfs-server
    else
        # If you downgrading to version older than 1.1.54336 run: systemctl disable clickhouse-server
        if [ -x "/etc/init.d/vxdfs-server" ]; then
            if [ -x "/usr/sbin/update-rc.d" ]; then
                /usr/sbin/update-rc.d vxdfs-server defaults 19 19 >/dev/null || exit $?
            else
                echo # Other OS
            fi
        fi
    fi

    # /etc/systemd/system/clickhouse-server.service shouldn't be distributed by the package, but it was
    # here we delete the service file if it was from our package
    if [ -f /etc/systemd/system/vxdfs-server.service ]; then
      SHA256=$(sha256sum /etc/systemd/system/vxdfs-server.service | cut -d' ' -f1)
      for ref_sum in 7769a14773e811a56f67fd70f7960147217f5e68f746010aec96722e24d289bb 22890012047ea84fbfcebd6e291fe2ef2185cbfdd94a0294e13c8bf9959f58f8 b7790ae57156663c723f92e75ac2508453bf0a7b7e8313bb8081da99e5e88cd3 d1dcc1dbe92dab3ae17baa395f36abf1876b4513df272bf021484923e0111eef ac29ddd32a02eb31670bf5f0018c5d8a3cc006ca7ea572dcf717cb42310dcad7 c62d23052532a70115414833b500b266647d3924eb006a6f3eb673ff0d55f8fa b6b200ffb517afc2b9cf9e25ad8a4afdc0dad5a045bddbfb0174f84cc5a959ed; do
        if [ "$SHA256" = "$ref_sum" ]; then
          rm /etc/systemd/system/vxdfs-server.service
          break
        fi
      done
    fi

    # Setup clickhouse-keeper directories
    chown -R "${VXDFS_USER}:${VXDFS_GROUP}" "${KEEPER_CONFDIR}"
    chmod 0755 "${KEEPER_CONFDIR}"

    if ! [ -d "${KEEPER_DATADIR}" ]; then
        mkdir -p "${KEEPER_DATADIR}"
        chown -R "${VXDFS_USER}:${VXDFS_GROUP}" "${KEEPER_DATADIR}"
        chmod 0700 "${KEEPER_DATADIR}"
    fi

    if ! [ -d "${KEEPER_LOGDIR}" ]; then
        mkdir -p "${KEEPER_LOGDIR}"
        chown -R "${VXDFS_USER}:${VXDFS_GROUP}" "${KEEPER_LOGDIR}"
        chmod 0770 "${KEEPER_LOGDIR}"
    fi
fi
